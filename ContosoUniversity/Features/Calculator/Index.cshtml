@{
    ViewData["Title"] = "Calculator";
}
<h2>@ViewData["Title"]</h2>

<form asp-action="Index" method="post" class="form-inline no-ajax">
    <div class="form-group">
        <input type="number" step="any" name="left" class="form-control" value="@ViewData["Left"]" required />
    </div>
    <div class="form-group">
        <input type="number" step="any" name="right" class="form-control" value="@ViewData["Right"]" required />
    </div>
    <button type="submit" class="btn btn-default">Calculate</button>
</form>

@if (ViewData["Sum"] != null)
{
    <dl class="dl-horizontal">
        <dt>Sum</dt>
        <dd>@ViewData["Sum"]</dd>
        <dt>Difference</dt>
        <dd>@ViewData["Difference"]</dd>
    </dl>
}
